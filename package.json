{
  "name": "clean-url-api",
  "version": "1.0.0",
  "description": "依 ClearURLs 規則集移除網址追蹤碼的 Cloudflare Worker",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run verify:rules && wrangler deploy --dry-run --outdir dist-worker",
    "deploy": "npm run verify:rules && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm run format && npm run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:rules": "tsx scripts/verify-rules.ts",
    "vendor": "bash scripts/vendor.sh"
  },
  "keywords": [
    "clearurls",
    "tracking",
    "url",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  }
}
