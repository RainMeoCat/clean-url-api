{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clean-url-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",

  // 規則集與清理邏輯都不碰 node: 內建模組（由 tests/worker.purity.test.ts 守著），
  // 因此不需要 nodejs_compat，bundle 更小也少一層相容層。

  // 走自訂網域的 route，不開 *.workers.dev：
  // WAF、Rate Limiting Rules、Cache Rules 都只作用在 zone 上，
  // workers.dev 網域等於一個繞過所有防護的後門。
  "workers_dev": false,
  "routes": [
    {
      // 結尾的 * 不可省略——不帶萬用字元的模式遇到查詢字串時
      // 匹配行為不可靠，而 GET 一定帶 ?url=
      "pattern": "rainmeocat.com/api/clean-url*",
      "zone_name": "rainmeocat.com",
    },
    {
      // apex 與 www 是兩個獨立主機，route 不會互相涵蓋。origin（Vercel）
      // 把 apex 308 轉到 www，網站主體在 www，因此兩個都要掛，
      // 否則打 www 的請求會落回 SPA 的 index.html 而不是這個 API。
      "pattern": "www.rainmeocat.com/api/clean-url*",
      "zone_name": "rainmeocat.com",
    },
  ],

  // handler 用這個值把 route 的 * 收斂成單一端點；改 route 時要一起改
  "vars": {
    "MOUNT_PATH": "/api/clean-url",
  },

  // 這裡刻意不設 limits.cpu_ms：該欄位僅付費方案可調，免費方案一律沿用平台
  // 預設的 10 ms CPU 上限。日後升級付費方案時可加回 "limits": { "cpu_ms": 50 }，
  // 讓惡意輸入（例如觸發規則 regex catastrophic backtracking）只燒掉自己那一個請求。

  "observability": {
    "enabled": true,
  },
}
